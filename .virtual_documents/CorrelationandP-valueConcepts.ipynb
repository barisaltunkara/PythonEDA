print(stats.linregress(df.age, df.charges))
# y = mx + b
# y = slope(x) + intercept


m, b, r, p, err = stats.linregress(df.age, df.charges)
x = range(18, 65)
y = m*x + b

plt.plot(x, y, "r")
plt.scatter(df.age, df.charges)
